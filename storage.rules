rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // El admin es una cuenta de Google verificada de la lista
    function esAdmin() {
      return request.auth != null
             && request.auth.token.email.lower() in [
                  'jarb2299@gmail.com',
                  'cristhiandccapa@gmail.com'
                ]
             && request.auth.token.email_verified == true;
    }

    match /{allPaths=**} {
      // Las imágenes del sitio las ve cualquiera.
      allow read: if true;

      // Solo el admin sube: imágenes o videos, hasta 50 MB.
      allow create, update: if esAdmin()
                            && request.resource.size < 50 * 1024 * 1024
                            && (request.resource.contentType.matches('image/.*')
                                || request.resource.contentType.matches('video/.*'));

      // Y solo el admin borra (en un borrado no hay archivo nuevo que revisar).
      allow delete: if esAdmin();
    }
  }
}
