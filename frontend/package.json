{
  "name": "kapac-made",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://www.kapac-made.com",
  "dependencies": {
    "firebase": "^12.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.15.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "prestart": "node scripts/textos.js",
    "start": "react-scripts start",
    "prebuild": "node scripts/textos.js",
    "build": "react-scripts build",
