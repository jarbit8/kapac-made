rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // El admin es una cuenta de Google verificada de la lista. Se compara en
    // minúsculas (Google puede devolver el correo con distinta capitalización
    // según cómo esté configurada la cuenta) para no depender de adivinar
    // la mayúscula exacta.
    function esAdmin() {
      return request.auth != null
             && request.auth.token.email.lower() in [
                  'jarb2299@gmail.com',
                  'cristhiandccapa@gmail.com'
                ]
             && request.auth.token.email_verified == true;
    }

    // ─── PRODUCTOS ───────────────────────────────────────────────────────────
    // El catálogo lo lee cualquiera; SOLO el admin puede crear/editar/borrar.
    match /productos/{productoId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ─── PEDIDOS ─────────────────────────────────────────────────────────────
    // Crear: un usuario autenticado crea UN pedido a su propio nombre.
    // Leer: solo el dueño o el admin.
    // Actualizar: el dueño puede tocar su pedido PERO no el total ni los items
    //   (eso impide manipular el precio); el admin puede todo.
    // Borrar: solo el admin.
    match /pedidos/{pedidoId} {
      // Un pedido SIEMPRE nace en 'procesando_pago': el cliente no puede crearlo
      // ya marcado como pagado/enviado. El total no puede ser negativo y los
      // items deben ser una lista. Marcar pagado lo hace el servidor (Admin SDK).
      allow create: if request.auth != null
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.items is list
                    && request.resource.data.estado == 'procesando_pago';

      allow read: if request.auth != null
                  && (resource.data.usuarioId == request.auth.uid || esAdmin());

      // El dueño puede tocar su pedido pero NO el total/items, y NO puede
      // ascender el estado a "pagado/enviado/entregado": solo dejarlo igual o
      // pasarlo a verificando_pago / cancelado. Marcar pagado lo hace el
      // servidor (Cloud Function, Admin SDK) o el admin.
      allow update: if esAdmin()
                    || (request.auth != null
                        && resource.data.usuarioId == request.auth.uid
                        && request.resource.data.usuarioId == resource.data.usuarioId
                        && request.resource.data.total == resource.data.total
                        && request.resource.data.items == resource.data.items
                        && (request.resource.data.estado == resource.data.estado
                            || request.resource.data.estado in ['verificando_pago', 'cancelado']));

      allow delete: if esAdmin();
    }

    // ─── PERFILES DE USUARIO ─────────────────────────────────────────────────
    // Cada usuario lee/escribe SOLO su propio perfil.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── CARRITOS (sincronización entre dispositivos) ────────────────────────
    // Cada usuario lee/escribe SOLO su propio carrito.
    match /carritos/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── VISITAS (contador anónimo, sin datos personales) ────────────────────
    // Cualquiera puede registrar una visita nueva; nadie puede alterar ni
    // borrar las existentes. Solo el admin lee las estadísticas.
    match /visitas/{docId} {
      allow read: if esAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // ─── NEWSLETTER ──────────────────────────────────────────────────────────
    // Se escribe SOLO desde la Cloud Function (Admin SDK, salta estas reglas).
    // Los correos de los suscriptores solo los lee el admin.
    match /newsletter/{docId} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // ─── CONTENIDO DEL SITIO (fotos de home / galería de producto) ───────────
    // Lo ve cualquiera; solo el admin lo edita.
    match /contenido/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ─── TODO LO DEMÁS ───────────────────────────────────────────────────────
    // Bloqueado por defecto (incluye reseñas, códigos de newsletter, etc.).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
