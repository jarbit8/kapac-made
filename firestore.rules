rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // El admin es una cuenta de Google verificada de la lista. Se compara en
    // minúsculas (Google puede devolver el correo con distinta capitalización
    // según cómo esté configurada la cuenta) para no depender de adivinar
    // la mayúscula exacta.
    function esAdmin() {
      return request.auth != null
             && request.auth.token.email.lower() in [
                  'jarb2299@gmail.com',
                  'cristhiandccapa@gmail.com'
                ]
             && request.auth.token.email_verified == true;
    }

    // ─── PRODUCTOS ───────────────────────────────────────────────────────────
    // El catálogo lo lee cualquiera; SOLO el admin puede crear/editar/borrar.
    match /productos/{productoId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ─── PEDIDOS ─────────────────────────────────────────────────────────────
    // Crear: un usuario autenticado crea UN pedido a su propio nombre.
    // Leer: solo el dueño o el admin.
    // Actualizar: el dueño solo lo justo para pagar y recibir avisos; el admin todo.
    // Borrar: solo el admin.
    match /pedidos/{pedidoId} {
      // Un pedido SIEMPRE nace en 'procesando_pago' y solo con los campos del
      // checkout: los del servidor (stockDescontado, culqiOrderId, códigos de
      // pago...) no los puede poner el cliente. Marcar pagado lo hace el servidor.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['usuarioId', 'email', 'nombre', 'items', 'total',
                                                             'estado', 'metodoPago', 'envio', 'esInvitado', 'fecha'])
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.items is list
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.estado == 'procesando_pago';

      allow read: if request.auth != null
                  && (resource.data.usuarioId == request.auth.uid || esAdmin());

      // El dueño solo puede avisar que ya pagó (procesando_pago → verificando_pago),
      // activar o quitar el aviso por correo y poner su correo si no lo dejó.
      // Ni el total, ni los items, ni cancelar, ni campos del servidor.
      allow update: if esAdmin()
                    || (request.auth != null
                        && resource.data.usuarioId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['estado', 'canalNotificacion', 'email'])
                        && (request.resource.data.estado == resource.data.estado
                            || (resource.data.estado == 'procesando_pago'
                                && request.resource.data.estado == 'verificando_pago'))
                        && (request.resource.data.get('email', null) == resource.data.get('email', null)
                            || resource.data.get('email', null) in [null, ''])
                        && request.resource.data.get('canalNotificacion', null) in [null, 'email']);

      allow delete: if esAdmin();
    }

    // ─── PERFILES DE USUARIO ─────────────────────────────────────────────────
    // Cada usuario lee/escribe SOLO su propio perfil.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── CARRITOS (sincronización entre dispositivos) ────────────────────────
    // Cada usuario lee/escribe SOLO su propio carrito.
    match /carritos/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── VISITAS (contador anónimo, sin datos personales) ────────────────────
    // Cualquiera puede registrar una visita nueva; nadie puede alterar ni
    // borrar las existentes. Solo el admin lee las estadísticas. El correo y el
    // uid tienen que ser los de la sesión: nadie registra visitas a nombre de otro.
    match /visitas/{docId} {
      allow read: if esAdmin();
      allow create: if request.resource.data.keys().hasOnly(['fecha', 'dia', 'ruta', 'sesionId', 'entrada', 'email',
                                                             'uid', 'pais', 'ciudad', 'dispositivo', 'navegador'])
                    && (request.resource.data.get('email', null) == null
                        || (request.auth != null && request.auth.token.email == request.resource.data.email))
                    && (request.resource.data.get('uid', null) == null
                        || (request.auth != null && request.auth.uid == request.resource.data.uid))
                    && request.resource.data.get('ruta', '') is string
                    && request.resource.data.get('ruta', '').size() <= 60
                    && request.resource.data.get('sesionId', '') is string
                    && request.resource.data.get('sesionId', '').size() <= 80;
      allow update, delete: if false;
    }

    // ─── NEWSLETTER ──────────────────────────────────────────────────────────
    // Se escribe SOLO desde la Cloud Function (Admin SDK, salta estas reglas).
    // Los correos de los suscriptores solo los lee el admin.
    match /newsletter/{docId} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // ─── CONTENIDO DEL SITIO (fotos de home / galería de producto) ───────────
    // Lo ve cualquiera; solo el admin lo edita.
    match /contenido/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ─── TODO LO DEMÁS ───────────────────────────────────────────────────────
    // Bloqueado por defecto (incluye reseñas, códigos de newsletter, etc.).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
